# ---------------------------------------------------------------------------
# Statistical Learning course repository
# ---------------------------------------------------------------------------

# PowerPoint sources are edited locally and NOT published.
# Only the exported lecture PDFs (01_Lectures/*.pdf) are tracked.
*.pptx
*.potx
~$*.pptx

# Exercise solutions stay private during the course.
# Students receive only the blank exercise notebooks.
*_Solution.ipynb

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.python-version

# OS cruft
.DS_Store
Thumbs.db

# Figures now live in per-slide subfolders (NN_figures/NN_topic/). The old flat
# copies at the root of each NN_figures folder are superseded; ignore them so
# only the organized subfolders are tracked. (Safe to delete the flat files.)
02_lectures_code/*_figures/*.pdf
02_lectures_code/*_figures/*.gif

