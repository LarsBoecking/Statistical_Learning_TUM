# ---------------------------------------------------------------------------
# Statistical Learning course repository
# ---------------------------------------------------------------------------

# PowerPoint sources are edited locally and NOT published.
# Only the exported lecture PDFs (01_Lectures/*.pdf) are tracked.
*.pptx
*.potx
~$*.pptx

# Exercise solutions stay private during the course.
# Students receive only the blank exercise notebooks.
*_Solution.ipynb

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.python-version

# OS cruft
.DS_Store
Thumbs.db

# Generated figures (PDF + SVG) are not tracked -- they are fully reproducible
# from the lecture notebooks via 02_lectures_code/src/build_all.sh, which also
# rebuilds the lossless lecture PDFs. Keeps the repository lean (the neural-
# network frames alone are ~37 MB).
02_lectures_code/*_figures/
